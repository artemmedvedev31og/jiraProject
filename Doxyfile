# Конфигурация Doxygen для проекта Genius Music Bot.
# Откройте этот файл через Doxywizard или запустите: doxygen Doxyfile

PROJECT_NAME           = "Genius Music Bot"
PROJECT_BRIEF          = "Telegram-бот для поиска музыкальных треков через Genius API"
PROJECT_NUMBER         = "1.0"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Russian

INPUT                  = mainpage.md README.md src/main/java
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.java *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = mainpage.md

OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES

USE_MATHJAX            = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Ссылки на исходные файлы и документацию
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_USED_FILES        = YES

# UTF-8 для русскоязычной документации
FORCE_UTF8             = YES
